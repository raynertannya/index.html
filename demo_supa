  "💸 Hasil: 2 invoice <b>Lunas</b>, 1 invoice <b>Dibayar Sebagian</b>. Perintah bayar sudah dikirim ke Rekap PO Agent.",
  "⚠️ Selisih pada invoice ketiga ditandai <b>Perlu Dicek</b> untuk Ray."]},
 c:{u:"submit",r:[
  "📨 Menyiapkan pengajuan: PDF digabung per PO dan kelengkapan dokumen sudah diperiksa.",
  "✅ Disetujui. Form atau email tagihan ke klien terkirim, dan statusnya dicatat ke sheet.",
  "🔒 Tanpa kata \"submit / kirim\" dari Ray, tidak ada tagihan yang keluar."]}
};
const box=document.getElementById("box"),btns=document.querySelectorAll(".btns button");
const wait=ms=>new Promise(r=>setTimeout(r,ms));
function add(cls,html){const d=document.createElement("div");d.className="msg "+cls;d.innerHTML=html;box.appendChild(d);box.scrollTop=box.scrollHeight;return d}
async function run(k){
  btns.forEach(b=>b.disabled=true);
  box.innerHTML="";
  add("me",S[k].u);
  await wait(500);
  for(const text of S[k].r){
    const t=add("ai typing","<span></span><span></span><span></span>");
    await wait(1100);
    t.classList.remove("typing");t.innerHTML=text;
    box.scrollTop=box.scrollHeight;
    await wait(350);
  }
  btns.forEach(b=>b.disabled=false);
}
btns.forEach(b=>b.addEventListener("click",()=>run(b.dataset.s)));
</script>

<script>
  const SUPABASE_URL = 'https://bmksputrjevqomfukkxq.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_UpkGXqL7RpVNuO3mxefZrg_G9KtFduS';

  let allPlaces = [];

  function formatNumber(num) {
    if (num == null) return '0';
    return Number(num).toLocaleString('id-ID');
  }

  function renderTable(data) {
    const tbody = document.getElementById('placesBody');
    const countBadge = document.getElementById('places-count');

    countBadge.textContent = `${data.length} Tempat Terdata`;

    if (!data.length) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="tbl-status">
            <div style="font-size: 1.5rem; margin-bottom: 6px;">🔍</div>
            <div>Tidak ada data tempat yang cocok.</div>
          </td>
        </tr>`;
      return;
    }

    const fragment = document.createDocumentFragment();

    data.forEach(p => {
      const tr = document.createElement('tr');

      // 1. Nama & Alamat
      const tdTitle = document.createElement('td');
      const infoBox = document.createElement('div');
      infoBox.className = 'place-info';
      const titleSpan = document.createElement('span');
      titleSpan.className = 'place-title';
      titleSpan.textContent = p.title || 'Tanpa Nama';
      infoBox.appendChild(titleSpan);

      if (p.street) {
        const addrSpan = document.createElement('span');
        addrSpan.className = 'place-address';
        addrSpan.title = p.street;
        addrSpan.textContent = p.street;
        infoBox.appendChild(addrSpan);
      }
      tdTitle.appendChild(infoBox);
      tr.appendChild(tdTitle);

      // 2. Kategori
      const tdCat = document.createElement('td');
      if (p.category_name) {
        const catChip = document.createElement('span');
        catChip.className = 'cat-chip';
        catChip.textContent = p.category_name;
        tdCat.appendChild(catChip);
      } else {
        tdCat.textContent = '-';
      }
      tr.appendChild(tdCat);

      // 3. Rating
      const tdScore = document.createElement('td');
      if (p.total_score != null) {
        const scorePill = document.createElement('span');
        scorePill.className = 'rating-pill';
        scorePill.innerHTML = `★ ${Number(p.total_score).toFixed(1)}`;
        tdScore.appendChild(scorePill);
      } else {
        tdScore.textContent = '-';
      }
      tr.appendChild(tdScore);

      // 4. Review
      const tdReviews = document.createElement('td');
      if (p.reviews_count != null) {
        tdReviews.innerHTML = `<span class="review-num">${formatNumber(p.reviews_count)}</span><span class="review-sub">ulasan</span>`;
      } else {
        tdReviews.textContent = '0';
      }
      tr.appendChild(tdReviews);

      // 5. Kota
      const tdCity = document.createElement('td');
      tdCity.innerHTML = `<span class="city-text">${p.city || '-'}</span>`;
      tr.appendChild(tdCity);

      // 6. Telepon
      const tdPhone = document.createElement('td');
      if (p.phone) {
        const cleanPhone = p.phone.replace(/[^0-9+]/g, '');
        const phoneLink = document.createElement('a');
        phoneLink.className = 'phone-btn';
        phoneLink.href = `tel:${cleanPhone}`;
        phoneLink.title = `Hubungi: ${p.phone}`;
        phoneLink.innerHTML = `📞 ${p.phone}`;
        tdPhone.appendChild(phoneLink);
      } else {
        tdPhone.innerHTML = '<span style="color:var(--mut)">-</span>';
      }
      tr.appendChild(tdPhone);

      // 7. Aksi Maps
      const tdAction = document.createElement('td');
      tdAction.style.textAlign = 'center';
      if (p.url && p.url.startsWith('https://')) {
        const mapBtn = document.createElement('a');
        mapBtn.className = 'btn-map';
        mapBtn.href = p.url;
        mapBtn.target = '_blank';
        mapBtn.rel = 'noopener';
        mapBtn.innerHTML = 'Maps ↗';
        tdAction.appendChild(mapBtn);
      } else {
        tdAction.innerHTML = '<span style="color:var(--mut)">-</span>';
      }
      tr.appendChild(tdAction);

      fragment.appendChild(tr);
    });

    tbody.replaceChildren(fragment);
  }

  function handleSearch() {
    const query = document.getElementById('searchInput').value.toLowerCase().trim();
    if (!query) {
      renderTable(allPlaces);
      return;
    }
    const filtered = allPlaces.filter(p => {
      const title = (p.title || '').toLowerCase();
      const cat = (p.category_name || '').toLowerCase();
      const city = (p.city || '').toLowerCase();
      const street = (p.street || '').toLowerCase();
      return title.includes(query) || cat.includes(query) || city.includes(query) || street.includes(query);
    });
    renderTable(filtered);
  }

  async function loadPlaces() {
    const tbody = document.getElementById('placesBody');
    try {
      const res = await fetch(
        SUPABASE_URL + '/rest/v1/places?select=*&order=reviews_count.desc.nullslast&limit=100',
        { headers: { apikey: SUPABASE_KEY } }
      );
      if (!res.ok) throw new Error('HTTP ' + res.status);
      allPlaces = await res.json();
      renderTable(allPlaces);
    } catch (e) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="tbl-status" style="color:var(--bad)">
            <div style="font-size: 1.5rem; margin-bottom: 6px;">⚠️</div>
            <div>Gagal memuat data dari Supabase.</div>
          </td>
        </tr>`;
      console.error(e);
    }
  }

  loadPlaces();
</script>
</body>
</html>
