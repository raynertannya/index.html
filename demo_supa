<script>
const S={
 a:{u:"Jalankan alur tagihan",r:[
  "📥 agen-po: 3 PO baru dari Gmail sudah dicatat ke sheet Rekap PO Agent.",
  "🧾 Subagen memproses tiap tagihan: invoice, kwitansi, Surat Jalan &amp; BAST, XML faktur pajak, lalu arsip ke Drive.",
  "✅ 3 tagihan berstatus <b>Siap Dikirim</b>. Menunggu perintah \"submit / kirim\" dari Ray."]},
 b:{u:"📎 Bukti transfer klien (sudah dibayar lumpsum)",r:[
